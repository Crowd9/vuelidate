{
  "name": "vuelidate",
  "version": "1.0.1",
  "private": true,
  "description": "Simple, lightweight model-based validation for Vue.js",
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vuelidate/vuelidate.git"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@vue/compiler-sfc": "^3.5.33",
    "@vue/test-utils": "2.4.8",
    "babel-jest": "^30.3.0",
    "core-js": "^3.49.0",
    "flush-promises": "^1.0.2",
    "jest": "^27.0.6",
    "jest-serializer-vue": "^3.1.0",
    "rollup": "^4.60.2",
    "rollup-plugin-copy": "^3.5.0",
    "vue": "^3.5.33"
  },
  "scripts": {
    "build": "npm -w @vuelidate/core run build && npm -w @vuelidate/validators run build && npm -w @vuelidate/components run build",
    "test": "jest",
    "prepare": "rm -rf packages/vuelidate/dist packages/validators/dist && npm run build"
  },
  "overrides": {
    "picomatch": "^4.0.4",
    "js-cookie": "^3.0.7",
    "@tootallnate/once": "^2.0.1",
    "form-data": "^3.0.5",
    "js-yaml": "^3.15.2",
    "ws": "^7.5.11"
  }
}
